# Node.js Server
PORT=3000
NODE_ENV=development

# Python Recognition Service
PYTHON_SERVICE_URL=http://localhost:8766
PYTHON_WS_URL=ws://localhost:8765

# Station & Kiosk Identity
STATION_CODE=MS
STATION_NAME=Chennai Egmore
KIOSK_ID=K-03

# Twilio Emergency Alert Configuration (Voice Call & SMS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# SMSHorizon Emergency SMS Configuration (India DLT Compliant)
SMSHORIZON_USER=your_smshorizon_username
SMSHORIZON_API_KEY=your_smshorizon_api_key
SMSHORIZON_SENDER_ID=MYTEXT

# Staff Destination Phone Number (10 digits)
STAFF_PHONE_NUMBER=+919876543210

# Staff Dashboard Port
STAFF_PORT=4000

# SMTP Email Configuration (Nodemailer for Lost & Found passenger notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
SMTP_FROM="SignMetro Station Control <your_email@gmail.com>"
